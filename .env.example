# (Optional) Google Gemini API Key
# Power Mayank AI Assistant with Google Gemini LLM for conversational intelligence.
# Get a free key at: https://aistudio.google.com/app/apikey
# If omitted, the assistant seamlessly runs on its built-in 25+ topic semantic engine.
GEMINI_API_KEY=

# (Optional) Web3Forms Access Key
# Enables direct inbox email forwarding from the Contact section form.
# Get a free key at: https://web3forms.com
# If omitted, the form automatically falls back to mailto: client composition.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
